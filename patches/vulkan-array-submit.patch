@@ -292,7 +292,23 @@ ovr_enum_t BaseCompositor::Submit(EVREye eye, const Texture_t* texture, const VR
 
 ovr_enum_t BaseCompositor::SubmitWithArrayIndex(vr::EVREye eye, const vr::Texture_t* texture, uint32_t idx, const vr::VRTextureBounds_t* bounds, vr::EVRSubmitFlags submitFlags)
 {
-	return Submit(eye, &texture[idx], bounds, submitFlags);
+	// The index selects a layer of the submitted texture, not an entry in an array of textures.
+	// A game that renders both eyes with multiview submits one layered image twice.
+	OOVR_LOG_ONCEF("SubmitWithArrayIndex: eye %d layer %u type %d flags 0x%x", (int)eye, idx, texture ? (int)texture->eType : -1, (unsigned)submitFlags);
+	if (texture && texture->eType == vr::TextureType_Vulkan && texture->handle) {
+		vr::VRVulkanTextureArrayData_t layer{};
+		if (submitFlags & vr::Submit_VulkanTextureWithArrayData)
+			layer = *static_cast<const vr::VRVulkanTextureArrayData_t*>(texture->handle);
+		else
+			static_cast<vr::VRVulkanTextureData_t&>(layer) = *static_cast<const vr::VRVulkanTextureData_t*>(texture->handle);
+		layer.m_unArrayIndex = idx;
+		if (layer.m_unArraySize <= idx)
+			layer.m_unArraySize = idx + 1;
+		vr::Texture_t layered = *texture;
+		layered.handle = &layer;
+		return Submit(eye, &layered, bounds, (vr::EVRSubmitFlags)(submitFlags | vr::Submit_VulkanTextureWithArrayData));
+	}
+	return Submit(eye, texture, bounds, submitFlags);
 }
 
