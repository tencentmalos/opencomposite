+
+bool BaseSystem::PollNextEventWithPoseAndOverlays(vr::ETrackingUniverseOrigin origin,
+    vr::VREvent_t* event, uint32_t size, vr::TrackedDevicePose_t* pose, vr::VROverlayHandle_t* overlay)
+{
+	if (!event || !overlay || size < sizeof(vr::VREvent_t)) return false;
+	*overlay = vr::k_ulOverlayHandleInvalid;
+	if (PollNextEventWithPose(origin, event, size, pose)) return true;
+	if (pose) *pose = {}; // overlay events do not carry a historical tracked pose
+	return GetBaseOverlay()->_PollNextEventWithHandle(event, size, overlay);
+}
