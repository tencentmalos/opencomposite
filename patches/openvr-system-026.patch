 {
 	STUBBED();
 }
+
+bool BaseOverlay::_PollNextEventWithHandle(vr::VREvent_t* event, uint32_t size, vr::VROverlayHandle_t* handle)
+{
+	if (!event || !handle || size < sizeof(vr::VREvent_t)) return false;
+	for (const auto& entry : overlays) {
+		auto candidate = reinterpret_cast<vr::VROverlayHandle_t>(entry.second);
+		if (entry.second && PollNextOverlayEvent(candidate, event, size)) {
+			*handle = candidate;
+			return true;
+		}
+	}
+	*handle = vr::k_ulOverlayHandleInvalid;
+	return false;
+}
+
+vr::EVROverlayError BaseOverlay::CreateSubviewOverlay(vr::VROverlayHandle_t, const char*,
+    const char*, vr::VROverlayHandle_t* output)
+{
+	if (!output) return vr::VROverlayError_InvalidParameter;
+	*output = vr::k_ulOverlayHandleInvalid;
+	// No parent/subview compositing is implemented by this bridge.
+	return vr::VROverlayError_RequestFailed;
+}
+
+vr::EVROverlayError BaseOverlay::SetSubviewPosition(vr::VROverlayHandle_t, float, float)
+{
+	return vr::VROverlayError_WrongTransformType;
+}
