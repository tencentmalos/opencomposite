+	const glm::vec3 d = glm::normalize(directions[0] + directions[1]);
+	const auto& m = projection->m;
+	const float x = m[0][0] * d.x + m[0][1] * d.y + m[0][2] * d.z;
+	const float y = m[1][0] * d.x + m[1][1] * d.y + m[1][2] * d.z;
+	const float w = m[3][0] * d.x + m[3][1] * d.y + m[3][2] * d.z;
+	if (w <= 0.0f)
+		return false;
+	*center = { x / w, y / w };
+	static int logged = 0;
+	if (logged < 12) {
+		logged++;
+		OOVR_LOGF("Foveation center for projection: frame %lld row0 %.4f %.4f %.4f %.4f row1 %.4f %.4f %.4f %.4f row3 %.4f %.4f %.4f %.4f gaze %.4f %.4f %.4f -> %.4f %.4f",
+		    (long long)xr_gbl->nextPredictedFrameTime, m[0][0], m[0][1], m[0][2], m[0][3], m[1][0], m[1][1], m[1][2], m[1][3],
+		    m[3][0], m[3][1], m[3][2], m[3][3], d.x, d.y, d.z, center->v[0], center->v[1]);
+	}
