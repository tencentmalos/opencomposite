+namespace {
+// The XR_FB_eye_tracking_social tracker of the current session, made on first use. A tracker
+// ends with its session, and OpenComposite recreates the session for the game's graphics API.
+XrEyeTrackerFB eyeTracker = XR_NULL_HANDLE;
+XrSession eyeTrackerSession = XR_NULL_HANDLE;
+
+// Each eye's gaze direction in the view space, or false while the runtime has none.
+bool LocateEyeGazes(glm::vec3 (&directions)[2])
+{
+	if (!xr_ext || !xr_ext->eyeTrackingSocialAvailable() || !xr_gbl)
+		return false;
+	XrSession session = xr_session.get();
+	if (session == XR_NULL_HANDLE)
+		return false;
+	if (eyeTrackerSession != session) {
+		eyeTrackerSession = session;
+		eyeTracker = XR_NULL_HANDLE;
+		XrEyeTrackerCreateInfoFB createInfo{ XR_TYPE_EYE_TRACKER_CREATE_INFO_FB };
+		XrResult res = xr_ext->xrCreateEyeTrackerFB(session, &createInfo, &eyeTracker);
+		OOVR_LOGF("Eye tracker for foveation centers: XrResult %d", res);
+		if (XR_FAILED(res))
+			eyeTracker = XR_NULL_HANDLE;
+	}
+	if (eyeTracker == XR_NULL_HANDLE)
+		return false;
+
+	XrEyeGazesInfoFB info{ XR_TYPE_EYE_GAZES_INFO_FB };
+	info.baseSpace = xr_gbl->viewSpace;
+	info.time = xr_gbl->GetBestTime();
+	XrEyeGazesFB gazes{ XR_TYPE_EYE_GAZES_FB };
+	if (XR_FAILED(xr_ext->xrGetEyeGazesFB(eyeTracker, &info, &gazes)))
+		return false;
+	bool valid[2] = {};
+	for (int eye = 0; eye < 2; eye++) {
+		valid[eye] = gazes.gaze[eye].isValid;
+		if (valid[eye])
+			directions[eye] = X2G_quat(gazes.gaze[eye].gazePose.orientation) * glm::vec3(0, 0, -1);
+	}
+	if (!valid[0] && !valid[1])
+		return false;
+	if (!valid[0])
+		directions[0] = directions[1];
+	if (!valid[1])
+		directions[1] = directions[0];
+	// Only a gaze into the view frustum has a centre to give.
+	return directions[0].z < -0.1f && directions[1].z < -0.1f;
+}
+
+// Where a view-space direction lands in an eye's NDC (y up), for the frustum GetProjectionMatrix builds.
+vr::HmdVector2_t EyeNdc(const XrView& view, const glm::vec3& direction)
+{
+	const glm::vec3 d = glm::inverse(X2G_quat(view.pose.orientation)) * direction;
+	const float x = d.x / -d.z, y = d.y / -d.z;
+	const float left = tanf(view.fov.angleLeft), right = tanf(view.fov.angleRight);
+	const float up = tanf(view.fov.angleUp), down = tanf(view.fov.angleDown);
+	return { 2.0f * (x - left) / (right - left) - 1.0f, 2.0f * (y - down) / (up - down) - 1.0f };
+}
+} // namespace
+
 bool BaseSystem::GetEyeTrackedFoveationCenter(vr::HmdVector2_t* left, vr::HmdVector2_t* right)
 {
+	OOVR_LOG_ONCE("Game asks for eye-tracked foveation centers");
 	if (left) *left = {};
 	if (right) *right = {};
-	return false;
+	glm::vec3 directions[2];
+	if (!LocateEyeGazes(directions))
+		return false;
+	const XruCachedViews views = xr_gbl->GetCachedViews(xr_gbl->viewSpace);
+	if (views.viewCount != XruEyeCount || !(views.viewState.viewStateFlags & XR_VIEW_STATE_ORIENTATION_VALID_BIT))
+		return false;
+	if (left) *left = EyeNdc(views.views[0], directions[0]);
+	if (right) *right = EyeNdc(views.views[1], directions[1]);
+	OOVR_LOG_ONCE("First eye-tracked foveation centers sent");
+	return true;
 }
 
-bool BaseSystem::GetEyeTrackedFoveationCenterForProjection(const vr::HmdMatrix44_t*, vr::HmdVector2_t* center)
