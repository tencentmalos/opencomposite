 #include <d3dcompiler.h> // For compiling shaders! D3DCompile
 
+#include <algorithm>
+#include <cmath>
+
+// A/B switch for measurements: while C:\gamenative-xr\opencomposite-full-copy exists, the
+// whole texture is copied again. Checked at most once a second.
+static bool FullCopyRequested()
+{
+	static ULONGLONG checkedAt = 0;
+	static bool full = false;
+	const ULONGLONG now = GetTickCount64();
+	if (checkedAt == 0 || now - checkedAt >= 1000) {
+		checkedAt = now;
+		const bool requested = GetFileAttributesW(L"C:\\gamenative-xr\\opencomposite-full-copy") != INVALID_FILE_ATTRIBUTES;
+		if (requested != full)
+			OOVR_LOGF("Full texture copy %s", requested ? "requested" : "released");
+		full = requested;
+	}
+	return full;
+}
+
